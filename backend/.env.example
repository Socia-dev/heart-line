# Copy this file to backend/.env and fill in what you have. backend/.env is never committed.

# Voice invitations (ElevenLabs). Without a key, the relative's page uses the browser's own voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_AR=
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_MODEL_ID=

# Sending a real invitation by email (optional). Either Resend, or plain SMTP.
RESEND_API_KEY=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
HEARTLINE_PUBLIC_URL=
